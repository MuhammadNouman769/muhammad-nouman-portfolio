CSRF_TRUSTED_ORIGINS=https://muhammadnouman.pythonanywhere.com
TIME_ZONE=Asia/Karachi

# PythonAnywhere terminates HTTPS in front of your app, so read HTTPS and visitor IPs from the proxy.
BEHIND_PROXY=True
# Leave False and use "Force HTTPS" on the Web tab instead.
SECURE_SSL_REDIRECT=False

# Private dashboard address (trailing slash). Change it to something only you know.
DASHBOARD_URL=dashboard/
ENABLE_DJANGO_ADMIN=False

# Database (SQLite)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Analytics
ANALYTICS_ENABLED=True
ANALYTICS_USE_COOKIE=True
ANALYTICS_ANONYMIZE_IP=False
ANALYTICS_RETENTION_DAYS=400

