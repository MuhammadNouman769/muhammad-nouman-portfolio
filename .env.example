# Copy to .env and edit. Never commit the real .env
DEBUG=False
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Public origin, no trailing slash. Drives canonical URLs, sitemap and social previews.
SITE_URL=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
TIME_ZONE=Asia/Karachi

# Behind nginx / Cloudflare / Caddy? Set True so HTTPS and visitor IPs are read correctly.
BEHIND_PROXY=True
SECURE_SSL_REDIRECT=False

# Private dashboard address (trailing slash). Change it to something only you know.
DASHBOARD_URL=dashboard/
# The stock Django admin stays off unless you enable it.
ENABLE_DJANGO_ADMIN=False

# Database (SQLite by default)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# PostgreSQL: DB_ENGINE=django.db.backends.postgresql, DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT

# Analytics
ANALYTICS_ENABLED=True
ANALYTICS_USE_COOKIE=True
ANALYTICS_ANONYMIZE_IP=False
ANALYTICS_RETENTION_DAYS=400

# Contact-form email notifications (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Portfolio <no-reply@yourdomain.com

# First-run defaults for Site settings (editable later in the dashboard)
OWNER_NAME=Muhammad Nouman
OWNER_EMAIL=nomannisar769@gmail.com
OWNER_PHONE=0324 8699647
OWNER_LOCATION=Farooqabad District, Sheikhupura
OWNER_GITHUB=https://github.com/MuhammadNouman769
OWNER_LINKEDIN=https://www.linkedin.com/in/muhammad-nouman-524ab9360/
